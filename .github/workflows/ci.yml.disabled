name: CI

permissions:
  contents: read

on:
  push:
    branches: [main, master, phase-11-ui, phase-12-api, phase-12b-rest, phase-12c-mcp, phase-12d-action, phase-13c-security-hardening, phase-13d-fuzzing, phase-13e-crash-recovery, phase-13f-distribution, phase-13g-update-check, phase-13h-user-guides-v2]
  pull_request:
    branches: [main, master, phase-13a-b-performance-cache, phase-13c-security-hardening, phase-13e-crash-recovery, phase-13f-distribution, phase-13g-update-check]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-test-lint:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      # Installs the version pinned in rust-toolchain.toml (with clippy + rustfmt),
      # so CI lints with exactly the same clippy as local runs.
      - name: Install pinned Rust toolchain
        run: rustup toolchain install && rustc -V && cargo clippy -V

      - name: Cache dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: ${{ runner.os }}-cargo-${{ hashFiles('rust-toolchain.toml', '**/Cargo.lock') }}
          restore-keys: |
            ${{ runner.os }}-cargo-

      - name: Resolve patched RustSec dependency
        run: cargo update -p url --precise 2.5.9

      - name: Build
        run: cargo build --all --verbose --locked

      - name: Run tests
        run: cargo test --all --verbose --locked

      - name: Clippy
        run: cargo clippy --all --all-targets --locked -- -D warnings

      - name: Format check
        run: cargo fmt --all -- --check

      - name: Upload resolved root Cargo.lock
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ummp-phase12-cargo-lockfile
          path: Cargo.lock
          if-no-files-found: error
      - name: Commit resolved workspace lockfile on phase branches
        if: always() && github.event_name == 'push' && startsWith(github.ref, 'refs/heads/phase-13')
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add Cargo.lock
          if git diff --cached --quiet; then
            echo "Cargo.lock is already current"
            exit 0
          fi
          git commit -m "chore(lock): sync resolved workspace lockfile"
          git push origin "HEAD:${GITHUB_REF_NAME}"

  desktop:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ui
    steps:
      - uses: actions/checkout@v4
      - name: Install pinned Rust toolchain
        run: rustup toolchain install && rustc -V
        working-directory: .
      - name: Install Tauri system libraries
        run: |
          sudo apt-get update
          sudo apt-get install -y libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev libxdo-dev libdbus-1-dev patchelf
        working-directory: .
      - name: Cache desktop Rust dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            ui/src-tauri/target/
          key: ${{ runner.os }}-desktop-cargo-${{ hashFiles('rust-toolchain.toml', 'ui/src-tauri/Cargo.lock') }}
          restore-keys: |
            ${{ runner.os }}-desktop-cargo-
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: ui/package-lock.json
      - run: npm ci
      - run: npm run check
      - name: Audit production dependencies
        run: npm audit --omit=dev || echo "npm audit reported advisories; review before release"
      - run: npx vitest run
      - run: npx playwright install chromium
      - run: npx playwright test
      - name: Upload Playwright screenshots and traces
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ummp-phase11-playwright
          path: ui/test-results/
          if-no-files-found: warn
      - name: Build web assets for the Tauri build script
        run: npm run build
      # Resolve and persist the desktop workspace lockfile before locked validation.
      # The committed desktop lockfile may lag newly added workspace dependencies.
      - name: Resolve patched desktop URL dependency
        run: cargo update -p url --precise 2.5.9
        working-directory: ui/src-tauri
      - run: cargo build --locked
        working-directory: ui/src-tauri
      - name: Upload resolved desktop lockfile for review
        uses: actions/upload-artifact@v4
        with:
          name: ummp-desktop-cargo-lockfile
          path: ui/src-tauri/Cargo.lock
          if-no-files-found: error
      - run: cargo test --locked
        working-directory: ui/src-tauri
      - run: cargo clippy --all-targets --locked -- -D warnings
        working-directory: ui/src-tauri
      - run: cargo fmt --check
        working-directory: ui/src-tauri

  security-audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install pinned Rust toolchain
        run: rustup toolchain install && rustc -V
      - name: Install Rust security tools
        run: |
          cargo install cargo-audit --locked
          cargo install cargo-deny --locked
      - name: Resolve patched RustSec dependency
        run: cargo update -p url --precise 2.5.9
      - name: Audit RustSec advisories
        run: cargo audit
      - name: Check dependency policy
        run: cargo deny check

  distribution-plan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install pinned cargo-dist
        run: |
          curl --proto '=https' --tlsv1.2 -LsSf https://github.com/axodotdev/cargo-dist/releases/download/v0.34.0/cargo-dist-installer.sh | sh
          dist --version
      - name: Regenerate cargo-dist workflow
        run: dist init --yes
      - name: Validate release configuration
        run: dist plan --output-format=json
